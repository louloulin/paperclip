{
  "name": "@paperclipai/adapter-ralph-local",
  "version": "0.1.0",
  "license": "MIT",
  "homepage": "https://github.com/paperclipai/paperclip",
  "bugs": {
    "url": "https://github.com/paperclipai/paperclip/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/paperclipai/paperclip",
    "directory": "packages/adapters/ralph-local"
  },
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./server": "./dist/server/index.js",
    "./types": "./dist/types.js"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.js",
        "import": "./dist/index.js"
      },
      "./server": {
        "types": "./dist/server/index.d.js",
        "import": "./dist/server/index.js"
      },
      "./types": {
        "types": "./dist/types.d.js",
        "import": "./dist/types.js"
      }
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@paperclipai/adapter-utils": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.7.3"
  }
}
